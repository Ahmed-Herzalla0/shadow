def cmd_query(args):
    """Run custom SQL query"""
    domain = args.domain
    query = args.sql
    
    output_dir = Path(args.output or f"output/{domain}")
    db_path = output_dir / "shadow.db"
    
    if not db_path.exists():
        print(f"[!] Database not found: {db_path}")
        sys.exit(1)
    
    db = Database(str(db_path))
    
    try:
        cur = db.conn.execute(query)
        rows = cur.fetchall()
        
        if not rows:
            print("[*] No results")
            return
        
        # Get column names
        columns = [desc[0] for desc in cur.description]
        
        # Print header
        print('\t'.join(columns))
        print('-' * 60)
        
        # Print rows
        for row in rows:
            print('\t'.join(str(v) for v in row))
            
    except Exception as e:
        print(f"[!] Query error: {e}")
        sys.exit(1)
    finally:
        db.close()


def main():
    parser = argparse.ArgumentParser(
        description='SHADOW - SQLite-Powered Bug Bounty Recon',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  shadow hunt example.com              # Full recon
  shadow hunt example.com --skip-nuclei  # Without vuln scanning
  shadow top example.com               # Show top 20 targets
  shadow top example.com -n 50         # Show top 50
  shadow export example.com            # Export URLs to stdout
  shadow export example.com -s 5 -f urls.txt  # Export score≥5 to file
  shadow stats example.com             # Show statistics
  shadow query example.com "SELECT * FROM findings"  # Custom query
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Command')
    
    # Hunt command
    hunt_parser = subparsers.add_parser('hunt', help='Full hunting workflow')
    hunt_parser.add_argument('domain', help='Target domain')
    hunt_parser.add_argument('-o', '--output', help='Output directory')
    hunt_parser.add_argument('--skip-nuclei', action='store_true',
                            help='Skip vulnerability scanning')
    hunt_parser.set_defaults(func=cmd_hunt)
    
    # Top command
    top_parser = subparsers.add_parser('top', help='Show top targets')
    top_parser.add_argument('domain', help='Target domain')
    top_parser.add_argument('-n', '--limit', type=int, default=20,
                           help='Number of targets (default: 20)')
    top_parser.add_argument('-o', '--output', help='Output directory')
    top_parser.set_defaults(func=cmd_top)
    
    # Export command
    export_parser = subparsers.add_parser('export', help='Export URLs')
    export_parser.add_argument('domain', help='Target domain')
    export_parser.add_argument('-s', '--min-score', type=int, default=0,
                              help='Minimum score (default: 0)')
    export_parser.add_argument('-f', '--file', help='Output file')
    export_parser.add_argument('-o', '--output', help='Output directory')
    export_parser.set_defaults(func=cmd_export)
    
    # Stats command
    stats_parser = subparsers.add_parser('stats', help='Show statistics')
    stats_parser.add_argument('domain', help='Target domain')
    stats_parser.add_argument('-o', '--output', help='Output directory')
    stats_parser.set_defaults(func=cmd_stats)
    
    # Query command
    query_parser = subparsers.add_parser('query', help='Run SQL query')
    query_parser.add_argument('domain', help='Target domain')
    query_parser.add_argument('sql', help='SQL query')
    query_parser.add_argument('-o', '--output', help='Output directory')
    query_parser.set_defaults(func=cmd_query)
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        sys.exit(1)
    
    args.func(args)


if __name__ == '__main__':
    main()
