def cmd_hunt(args: argparse.Namespace) -> int:
    """
    Full hunting workflow with decision-driven orchestration.
    
    Returns exit code: 0=success, 1=partial, 2=error
    """
    target = args.target
    scope = args.scope
    output_dir = Path(args.output) if args.output else Path(f"output/{target}")
    
    print(BANNER)
    print(f"[*] Target: {target}")
    print(f"[*] Scope: {scope}")
    print(f"[*] Output: {output_dir}")
    print()
    
    # Create orchestrator and run
    try:
        orch = Orchestrator(
            target=target,
            output_dir=str(output_dir),
            scope=scope,
            debug=args.debug,
            resume=args.resume,
        )
        
        success = orch.run()
        
        if success:
            print(f"\n[✓] Scan complete!")
            print(f"[*] Ranked targets: {output_dir}/targets_ranked.json")
            print(f"[*] View top targets: shadow top {target}")
            return 0
        else:
            print(f"\n[!] Scan completed with errors")
            return 1
            
    except KeyboardInterrupt:
        print(f"\n[!] Interrupted. Resume with: shadow hunt {target} --resume")
        return 130
    except Exception as e:
        print(f"\n[✗] Fatal error: {e}")
        if args.debug:
            import traceback
            traceback.print_exc()
        return 2


def cmd_top(args: argparse.Namespace) -> int:
    """Show top ranked targets from previous scan."""
    target = args.target
    limit = args.limit
    output_dir = Path(args.output) if args.output else Path(f"output/{target}")
    
    ranked_file = output_dir / "targets_ranked.json"
    
    if not ranked_file.exists():
        print(f"[!] No ranked targets found for {target}")
        print(f"    Run: shadow hunt {target}")
        return 1
    
    try:
        with open(ranked_file) as f:
            data = json.load(f)
        
        targets = data.get("targets", [])[:limit]
        
        if not targets:
            print("[!] No targets found")
            return 1
        
        print(f"\n{'=' * 70}")
        print(f"  TOP {len(targets)} TARGETS - {target}")
        print(f"{'=' * 70}\n")
        
        for i, t in enumerate(targets, 1):
            score = t.get("score", 0)
            priority = t.get("priority", "unknown")
            url = t.get("url", "N/A")
            action = t.get("action", "N/A")
            reasons = t.get("reasons", [])[:3]
            
            # Priority color indicator
            priority_icons = {
                "critical": "🔴",
                "high": "🟠", 
                "medium": "🟡",
                "low": "🟢",
                "noise": "⚪",
            }
            icon = priority_icons.get(priority, "⚪")
            
            print(f"#{i} [{score}] {icon} {priority.upper()}")
            print(f"   URL: {url}")
            print(f"   Action: {action}")
            if reasons:
                print(f"   Reasons: {', '.join(reasons[:3])}")
            print()
        
        return 0
        
    except Exception as e:
        print(f"[!] Error reading targets: {e}")
        return 1


def cmd_export(args: argparse.Namespace) -> int:
    """Export URLs for external tools like nuclei, dalfox, etc."""
    target = args.target
    min_score = args.min_score
    output_dir = Path(args.output) if args.output else Path(f"output/{target}")
    
    ranked_file = output_dir / "targets_ranked.json"
    
    if not ranked_file.exists():
        print(f"[!] No ranked targets found for {target}")
        return 1
    
    try:
        with open(ranked_file) as f:
            data = json.load(f)
        
        targets = data.get("targets", [])
        
        # Filter by minimum score
        filtered = [t for t in targets if t.get("score", 0) >= min_score]
        
        if not filtered:
            print(f"[!] No targets with score >= {min_score}")
            return 1
        
        # Output format
        if args.format == "urls":
            for t in filtered:
                print(t.get("url", ""))
        elif args.format == "json":
            print(json.dumps(filtered, indent=2))
        elif args.format == "nuclei":
            # Output in format for nuclei
            for t in filtered:
                url = t.get("url", "")
                if url:
                    print(url)
        
        return 0
        
    except Exception as e:
        print(f"[!] Error exporting: {e}")
        return 1


def cmd_stats(args: argparse.Namespace) -> int:
    """Show scan statistics."""
    target = args.target
    output_dir = Path(args.output) if args.output else Path(f"output/{target}")
    
    ranked_file = output_dir / "targets_ranked.json"
    state_file = output_dir / "state.db"
    
    if not ranked_file.exists():
        print(f"[!] No scan data found for {target}")
        return 1
    
    try:
        with open(ranked_file) as f:
            data = json.load(f)
        
        targets = data.get("targets", [])
        metadata = data.get("metadata", {})
        
        print(f"\n{'=' * 50}")
        print(f"  SCAN STATISTICS - {target}")
        print(f"{'=' * 50}\n")
        
        print(f"Total targets: {len(targets)}")
        print(f"Scan time: {metadata.get('scan_time', 'N/A')}")
        print(f"Scope: {metadata.get('scope', 'N/A')}")
        
        # Priority breakdown
        priorities = {}
        for t in targets:
            p = t.get("priority", "unknown")
            priorities[p] = priorities.get(p, 0) + 1
        
        print(f"\nPriority breakdown:")
        for p, count in sorted(priorities.items()):
            print(f"  {p}: {count}")
        
        # Top tags
        tags = {}
        for t in targets:
            for tag in t.get("tags", []):
                tags[tag] = tags.get(tag, 0) + 1
        
        print(f"\nTop vulnerability tags:")
        for tag, count in sorted(tags.items(), key=lambda x: -x[1])[:10]:
            print(f"  {tag}: {count}")
        
        return 0
        
    except Exception as e:
        print(f"[!] Error: {e}")
        return 1


def main() -> int:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        prog="shadow",
        description="SHADOW - Decision-Driven Recon Orchestrator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  shadow hunt target.com              # XSS-focused scan
  shadow hunt target.com --scope full # Full recon
  shadow top target.com --limit 20    # Top 20 targets
  shadow export target.com --min-score 10 > urls.txt
        """,
    )
    parser.add_argument("--version", action="version", version=f"SHADOW {VERSION}")
    
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # Hunt command
    hunt_parser = subparsers.add_parser("hunt", help="Run full hunting workflow")
    hunt_parser.add_argument("target", help="Target domain")
    hunt_parser.add_argument("--output", "-o", help="Output directory")
    hunt_parser.add_argument(
        "--scope", 
        choices=["xss", "full", "api", "js"],
        default="xss",
        help="Scanning scope (default: xss)",
    )
    hunt_parser.add_argument("--resume", "-r", action="store_true", help="Resume interrupted scan")
    hunt_parser.add_argument("--debug", "-d", action="store_true", help="Enable debug output")
    hunt_parser.add_argument(
        "--allow-destructive",
        action="store_true",
        help="Allow destructive modules (nuclei with payloads)",
    )
    hunt_parser.add_argument(
        "--confirm-legal",
        action="store_true",
        help="Confirm you have permission to scan the target",
    )
    hunt_parser.set_defaults(func=cmd_hunt)
    
    # Top command
    top_parser = subparsers.add_parser("top", help="Show top ranked targets")
    top_parser.add_argument("target", help="Target domain")
    top_parser.add_argument("--output", "-o", help="Output directory")
    top_parser.add_argument("--limit", "-l", type=int, default=10, help="Number of targets")
    top_parser.set_defaults(func=cmd_top)
    
    # Export command
    export_parser = subparsers.add_parser("export", help="Export targets for external tools")
    export_parser.add_argument("target", help="Target domain")
    export_parser.add_argument("--output", "-o", help="Output directory")
    export_parser.add_argument("--min-score", "-m", type=int, default=5, help="Minimum score")
    export_parser.add_argument(
        "--format", "-f",
        choices=["urls", "json", "nuclei"],
        default="urls",
        help="Output format",
    )
    export_parser.set_defaults(func=cmd_export)
    
    # Stats command
    stats_parser = subparsers.add_parser("stats", help="Show scan statistics")
    stats_parser.add_argument("target", help="Target domain")
    stats_parser.add_argument("--output", "-o", help="Output directory")
    stats_parser.set_defaults(func=cmd_stats)
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 0
    
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
