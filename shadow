def cmd_hunt(args):
    """Full hunting workflow"""
    domain = args.domain
    
    # Setup output directory
    output_dir = Path(args.output or f"output/{domain}")
    output_dir.mkdir(parents=True, exist_ok=True)
    
    db_path = output_dir / "shadow.db"
    
    print(BANNER)
    print(f"Target: {domain}")
    print(f"Database: {db_path}")
    print()
    
    # Run orchestrator
    orch = Orchestrator(str(db_path))
    
    try:
        stats = orch.hunt(domain, skip_nuclei=args.skip_nuclei)
    finally:
        orch.close()
    
    print(f"\n[✓] Done! Results saved to: {db_path}")
    print(f"    Run: shadow top {domain} to see top targets")


def cmd_top(args):
    """Show top targets"""
    domain = args.domain
    limit = args.limit
    
    output_dir = Path(args.output or f"output/{domain}")
    db_path = output_dir / "shadow.db"
    
    if not db_path.exists():
        print(f"[!] Database not found: {db_path}")
        print(f"    Run: shadow hunt {domain} first")
        sys.exit(1)
    
    db = Database(str(db_path))
    
    try:
        targets = db.get_top_targets(limit=limit)
        
        if not targets:
            print("[!] No targets found")
            return
        
        print(f"\n{'=' * 60}")
        print(f"  TOP {len(targets)} TARGETS - {domain}")
        print(f"{'=' * 60}\n")
        
        for i, target in enumerate(targets, 1):
            print(f"#{i}")
            print(format_target(target))
            print()
        
    finally:
        db.close()


def cmd_export(args):
    """Export URLs for external tools"""
    domain = args.domain
    min_score = args.min_score
    
    output_dir = Path(args.output or f"output/{domain}")
    db_path = output_dir / "shadow.db"
    
    if not db_path.exists():
        print(f"[!] Database not found: {db_path}", file=sys.stderr)
        sys.exit(1)
    
    db = Database(str(db_path))
    
    try:
        urls = db.export_urls(min_score=min_score)
        
        if args.file:
            with open(args.file, 'w') as f:
                f.write('\n'.join(urls))
            print(f"[+] Exported {len(urls)} URLs to {args.file}", file=sys.stderr)
        else:
            for url in urls:
                print(url)
                
    finally:
        db.close()


